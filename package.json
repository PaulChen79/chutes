{
  "name": "chutes",
  "version": "0.0.0",
  "description": "Per-file triage for large refactors: sort every file into mechanical, judgment, or redesign with calibrated confidence.",
  "license": "MIT",
  "author": "Paul Chen",
  "homepage": "https://github.com/PaulChen79/chutes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulChen79/chutes.git"
  },
  "bugs": {
    "url": "https://github.com/PaulChen79/chutes/issues"
  },
  "keywords": [
    "migration",
    "refactoring",
    "triage",
    "static-analysis",
    "cli",
    "dependency-graph",
    "code-migration"
  ],
  "type": "module",
  "bin": {
    "chutes": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --exclude '**/node_modules/**' tests/jev.live.test.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "commander": "^14.0.1",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^24.10.1",
    "@types/picomatch": "^4.0.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
